static func color(index: int) -> Color:
	var row: Array=COLORS[index] if index>=0 and index<COLORS.size() else [0,0,0,255]
	return Color8(row[0],row[1],row[2],row[3])
static func color_type(type: int,opacity: int=255) -> Array:
	if not GRADIENTS.has(type): return []
	var result: Array=[]
	for i in 4:
		var row: Array=GRADIENTS[type][i]
		result.append(Color8(row[0],row[1],row[2],clampi(opacity,0,255) if i in [1,2] or type in [7,8] else 0))
	return result
