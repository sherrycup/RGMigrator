## 职责：集中定义闪翼界面的配色与颜色查询规则。
##
## 调用方式：
##   静态接口：preload("res://runtime/scripts/04_UI_Common/Palette.gd").方法名(...)。
##
## 调用接口：
##   static func color(index: int) -> Color
##     参数 index（int；必填）：集合或列表中的位置索引。
##     返回：Color 类型的对象或值，供调用方继续使用。
##
##   static func color_type(type: int, opacity: int = 255) -> Array
##     参数 type（int；必填）：当前操作的类型标识。
##     参数 opacity（int；默认值 255）：透明度参数，取值按对应显示接口约定。
##     返回：按本方法约定排列的集合；元素类型见返回类型。
##
## 公开常量：COLORS、GRADIENTS。
## 接口说明结束。

extends RefCounted
## Source 0040 Storage.color_set and color_type, distinct from Message.color.
const COLORS = [
	[255, 255, 255, 255],
	[128, 128, 255, 255],
	[255, 128, 128, 255],
	[128, 255, 128, 255],
	[128, 255, 255, 255],
	[255, 128, 255, 255],
	[255, 255, 128, 255],
	[192, 192, 192, 255],
	[0, 0, 0, 255],
	[255, 50, 50, 255],
	[140, 140, 140, 255],
	[255, 255, 0, 200],
	[255, 192, 128, 255],
	[164, 58, 228, 255],
	[255, 24, 224, 255],
	[255, 124, 224, 255],
	[255, 160, 176, 255],
	[192, 224, 255, 255],
	[255, 255, 255, 255],
	[255, 255, 255, 128],
	[255, 255, 64, 255],
	[255, 64, 0, 255],
	[221, 153, 68, 255],
	[0, 191, 255, 255],
	[255, 34, 34, 255],
	[68, 187, 68, 255],
	[102, 102, 102, 255]
]
const GRADIENTS = {
	0: [[96, 64, 32], [96, 64, 32], [192, 128, 64], [192, 128, 64]],
	1: [[128, 255, 224], [128, 255, 224], [255, 255, 255], [32, 192, 160]],
	2: [[128, 224, 255], [128, 224, 255], [255, 255, 255], [32, 160, 192]],
	3: [[224, 255, 128], [224, 255, 128], [255, 255, 255], [160, 192, 32]],
	4: [[224, 128, 255], [224, 128, 255], [255, 255, 255], [160, 32, 192]],
	5: [[255, 192, 128], [255, 192, 128], [255, 224, 192], [192, 160, 32]],
	6: [[255, 255, 128], [255, 255, 128], [255, 255, 255], [192, 192, 32]],
	7: [[192, 64, 32], [255, 192, 128], [255, 128, 64], [192, 64, 32]],
	8: [[144, 48, 24], [192, 144, 96], [192, 96, 48], [144, 48, 24]],
	10: [[128, 128, 255], [128, 128, 255], [255, 255, 255], [32, 32, 192]],
	11: [[255, 128, 128], [255, 128, 128], [255, 255, 255], [128, 32, 32]],
	12: [[128, 255, 128], [128, 255, 128], [255, 255, 255], [32, 192, 32]]
}


static func color(index: int) -> Color:
	var row: Array = COLORS[index] if index >= 0 and index < COLORS.size() else [0, 0, 0, 255]
	return Color8(row[0], row[1], row[2], row[3])


static func color_type(type: int, opacity: int = 255) -> Array:
	if not GRADIENTS.has(type):
		return []
	var result: Array = []
	for i in 4:
		var row: Array = GRADIENTS[type][i]
		result.append(
			Color8(
				row[0],
				row[1],
				row[2],
				clampi(opacity, 0, 255) if i in [1, 2] or type in [7, 8] else 0
			)
		)
	return result
