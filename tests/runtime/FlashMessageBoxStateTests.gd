extends SceneTree
var Box: Script
var checks=0
var failures: Array[String]=[]
func _init() -> void: call_deferred("run")
func run() -> void:
	Box=load("res://runtime/scripts/FlashMessageBoxState.gd"); var state=root.get_node("RuntimeState")
	var value=Box.new("ab",state)
	for i in 10: value.tick()
	expect(value.process==0 and value.plain_text().is_empty() and not value.finished(),"source ten-frame entrance precedes any text paint")
	value.tick(); var first=value.plain_text(); value.tick(); value.tick()
	expect(first=="a" and value.plain_text()=="ab","source speed1 is one glyph followed by one raw frame wait at60Hz")
	value.tick(); value.confirm()
	expect(value.state==-1 and not value.finished(),"source complete blocking text starts close on confirm")
	for i in 10: value.tick()
	expect(value.finished() and value.zoom()==0,"source close finishes after ten frames with no engine loop blocking")
	value=Box.new("\\mo[1]\\>abc\\w[20]de\\t[2]",state,true)
	value.tick(); value.tick()
	expect(value.plain_text()=="abc" and value.waiting==30 and value.opacity()==0 and value.zoom()==1,"source instant/no-background mode processes text up to authored40 wait20 scaled30")
	for i in 30: value.tick()
	expect(value.plain_text()=="abc" and value.waiting==0,"source explicit wait consumes its exact duration without extra glyphs")
	value.tick()
	expect(value.plain_text()=="abcde" and value.auto_terminate==3,"source hint finishes visible glyphs before authored auto-close control")
	value.tick(); value.tick(); value.tick(); value.tick()
	expect(value.state==-1,"source hint auto timer reaches close after completed text and scaled delay")
	value=Box.new("\\mo[2]\\>a\\.b\\!c",state); value.tick(); value.tick()
	expect(value.plain_text()=="ab" and not value.interpreter_waiting and value.state==2,"source wake releases only interpreter while pause retains box and later glyph")
	value.confirm(); value.tick()
	expect(value.plain_text()=="abc" and value.state==0,"repaired source pause can resume without an invented item/event write")
	value=Box.new("\\mo[1]\\mu[2,-4]x",state,true); value.tick(); value.tick()
	for i in 3: value.tick()
	expect(value.offset==Vector2(0,12) and value.plain_text().is_empty(),"source message movement applies signed pixel direction for exact scaled3 frames")
	value.tick()
	expect(value.plain_text()=="x","movement finishes before next glyph resumes")
	value=Box.new("\\mo[1]\\C[5]a\\FB[T]b\\FI[T]c\\bo[50]",state); value.tick()
	for i in 15: value.tick()
	expect(value.painted[0].style.color==5 and not value.painted[0].style.bold and value.painted[1].style.bold and value.painted[2].style.italic and value.back_opacity==50,"source parameter controls consume frames and each painted glyph retains its own prior style")
	value=Box.new("\\mo[1]permanent hint",state,true); value.tick()
	for i in 60: value.tick()
	value.confirm()
	expect(value.state==3 and not value.finished(),"source hint without terminate control stays visible and does not invent a default expiration")
	value=Box.new("\\mo[1]\\>hint\\bo[50]\\bo[255]",state,true); value.tick(); value.tick()
	expect(is_equal_approx(value.opacity(),50.0/255) and is_equal_approx(value.frame_opacity(),50.0/255),"source HintBox BO fades the entire hint rather than TextBox frame-only opacity")
	value.tick()
	expect(value.opacity()==1,"source last hint opacity control exposes already painted glyphs")
	value=Box.new("\\mo[1]\\bo[50]x",state); value.tick(); value.tick()
	expect(value.opacity()==0 and is_equal_approx(value.frame_opacity(),50.0/255),"source TextBox mode1 can expose frame alone with BO while content stays hidden")
	value=Box.new("\\mo[2]x",state); value.tick(); value.tick()
	expect(value.opacity()==1 and value.frame_opacity()==0,"source mode2 content appears without its background frame")
	for message in failures: printerr("FAIL: ",message)
	print("FLASH MESSAGE BOX STATE: ","PASSED" if failures.is_empty() else "FAILED"," / ",checks," checks")
	quit(0 if failures.is_empty() else 1)
func expect(value: bool,message: String) -> void:
	checks+=1
	if not value: failures.append(message)
