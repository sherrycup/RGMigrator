extends SceneTree
const Data=preload("res://runtime/scripts/RuntimeData.gd")
const Scripts=preload("res://runtime/scripts/ScriptRuntime.gd")
const Unravel=preload("res://runtime/scripts/FlashUnravel.gd")
const Broken=preload("res://runtime/scripts/FlashBrokenScreen.gd")
var checks=0
var failures: Array[String]=[]
func _init() -> void: call_deferred("run")
func run() -> void:
	root.size=Vector2i(640,640)
	var state=root.get_node("RuntimeState"); state.begin_new_game(Data.system(),{"enabled":false}); state.map_id=10; state.party=[2]; state.variables["14"]=[2,0]
	var game: Node=load("res://runtime/scripts/Game.gd").new(); game._events_enabled=false; root.add_child(game); await process_frame
	game.reset_event_execution(); game._events_enabled=false; game.set_process(false); game._player.set_process(false)
	var model=state.flash_effects; var view: Node=model._view.get_ref(); view.set_process(false)
	expect(view._particle_canvases.size()==3 and view._particle_canvases[0].material.blend_mode==CanvasItemMaterial.BLEND_MODE_MIX and view._particle_canvases[1].material.blend_mode==CanvasItemMaterial.BLEND_MODE_ADD and view._particle_canvases[2].material.blend_mode==CanvasItemMaterial.BLEND_MODE_SUB,"particle rendering respects source normal/additive/subtractive blend types independently")
	var image=Image.create(640,640,false,Image.FORMAT_RGBA8); image.fill(Color.RED); model.test_capture=image
	var initial=image.get_data()
	# Fatal case is covered in FlashFailureIsolationProbe: effect
	var enter=game.play_flash_effect("set_rect",[]); model.advance(6.0/60)
	expect(enter.ok and model.rect_amount==56 and model.status(enter.flash_effect_request).get("pending",false),"original bars advance exact first six steps while event remains waiting")
	var interpreter=load("res://runtime/scripts/EventInterpreter.gd").new(); interpreter.managed=true; interpreter.map_runtime=game._map
	interpreter.start([{"code":121,"indent":0,"parameters":[333,333,0]},{"code":0,"indent":0,"parameters":[]}],1); interpreter._wait_for_script(enter); interpreter.advance(1.0/60)
	expect(not state.switches.get("333",false) and interpreter.wait_kind().begins_with("flash_effect:"),"actual event interpreter does not execute its next command before effect completion")
	model.advance(6.0/60); interpreter.advance(1.0/60)
	expect(model.rect_amount==74 and model.status(enter.flash_effect_request).ok and state.switches.get("333",false),"twelfth source bar frame completes its request and releases actual event exactly once")
	var exit=game.play_flash_effect("set_rect",[1]); model.advance(12.0/60)
	expect(exit.ok and model.rect_amount==0 and not model.busy(),"original reverse steps remove both74pixel bars")
	var freeze=game.play_flash_effect("freeze",[null]); model.advance(0)
	var color=model.frozen.get_image().get_pixel(10,10)
	expect(freeze.ok and color.r8==color.g8 and color.g8==color.b8 and abs(color.r-0.299)<0.01 and image.get_data()==initial,"source freeze produces weighted-gray snapshot without mutating capture or cached images")
	game.play_flash_effect("unfreeze",[null]); model.advance(0)
	expect(model.frozen==null,"unfreeze safely releases the current owned snapshot")
	game.play_flash_effect("unfreeze",[null]); model.advance(0)
	expect(not model.busy(),"repeated unfreeze has no missing-object dereference")
	var blur=game.play_flash_effect("Blur",[true]); model.advance(12.0/60)
	expect(blur.ok and model.blur_radius==12 and model.blurred!=null and not model.map_visible and not model.busy(),"source blur holds its independent snapshot after twelve frames and hides only map viewport")
	var blur_exit=game.play_flash_effect("Blur",[false]); model.advance(11.0/60)
	expect(model.blur_radius==2 and model.status(blur_exit.flash_effect_request).get("pending",false),"reverse blur preserves twelve-to-one source radius progression")
	model.advance(1.0/60)
	expect(model.blurred==null and model.map_visible and model.blur_radius==0,"last reverse frame disposes the blur instance and restores map")
	var voice=game.play_flash_effect("Voiceover",[true])
	expect(voice.ok and state.switches.get("4",false) and not state.switches.get("3",true) and state.variables["13"]==192,"source voiceover mask and sight switches commit with its effect request")
	model.advance(40.0/60)
	expect(model.voice_visible and is_equal_approx(model.voice_zoom,0.8) and model.voice_alpha==255,"voiceover reaches original forty-frame zoom and opacity endpoints")
	game.play_flash_effect("Voiceover",[false]); model.advance(30.0/60)
	expect(not model.voice_visible and state.switches["3"] and not state.switches["4"],"voiceover removes its image after thirty exit frames and restores source switches")
	# Fatal case is covered in FlashFailureIsolationProbe: missing-scan
	var scan=game.play_flash_effect("Scanline",[1]); expect(scan.ok,"original scanline SE restored by the audio import fix is usable"); model.advance(119.0/60)
	expect(model.transient.direction==1 and model.transient.tick==119 and model.status(scan.flash_effect_request).get("pending",false),"real scanline request preserves its source direction through frame119")
	model.advance(1.0/60)
	expect(model.transient.is_empty() and model.status(scan.flash_effect_request).ok,"frame120 releases all transient scanline state")
	# Fatal case is covered in FlashFailureIsolationProbe: missing-noise
	var noise=game.play_flash_effect("Flashback",[]); expect(noise.ok,"original flashback SE restored by the audio import fix is usable"); model.advance(7.0/60)
	expect(noise.ok and model.transient.tick==6,"source noise starts after six shake frames")
	model.advance(33.0/60)
	expect(model.transient.is_empty() and state.screen._data.shake==0 and model.status(noise.flash_effect_request).ok,"source40frame flashback releases overlays and clears shake")
	var wake=game.play_flash_effect("wake",[])
	model.advance(1.0/60)
	expect(model.transient.tree_texture.get_image().get_pixel(300,300).a>0,"original JPEG wake tree is converted to owned RGBA before composing the transparent canvas")
	for i in 500: model.advance(1.0/60)
	expect(wake.ok and model.status(wake.flash_effect_request).ok and model.transient.is_empty() and model.map_visible,"original eye sequence executes all source levels and finishes with live map restored")
	# Fatal case is covered in FlashFailureIsolationProbe: invalid-effect
	var batch=Scripts.call_transaction(state,{"source":"batch cancel"},func(env):
		load("res://runtime/scripts/FlashScreenEffects.gd").stage(env._custom,"set_rect",[])
		return load("res://runtime/scripts/FlashScreenEffects.gd").stage(env._custom,"Blur",[true]))
	model.advance(1.0/60); model.cancel(batch.flash_effect_request)
	expect(not model.busy() and not model.status(batch.flash_effect_request).ok and model.rect_amount==0,"cancelling a last queued token also restores bars and cancels active members of the same script batch")
	var mask_before=[state.switches.get("4",false),state.switches.get("3",false),state.variables.get("13",0)]
	var cancelled_voice=game.play_flash_effect("Voiceover",[true]); model.advance(3.0/60); model.cancel(cancelled_voice.flash_effect_request)
	expect(not model.voice_visible and [state.switches.get("4",false),state.switches.get("3",false),state.variables.get("13",0)]==mask_before,"cancelling voiceover restores its owned image and pre-request mask/sight state")
	var square=Image.create(8,8,false,Image.FORMAT_RGBA8); square.fill(Color.WHITE); var bytes=square.get_data()
	var particles=Unravel.new(); var made=particles.configure(square,Vector2(20,20),Rect2i(0,0,8,8),0,4,300,"LRUD","S",true,42)
	expect(made.ok and made.count==4 and square.get_data()==bytes and particles.image.get_pixel(1,1).a==0,"unravel captures four source grid pieces, clearing only its private image")
	particles.advance_ticks(1)
	expect(particles.disposed and particles.particles.is_empty(),"all adjacent expired particles update and dispose in the same frame")
	particles=Unravel.new(); particles.configure(square,Vector2(20,20),Rect2i(0,0,8,8),-1,4,0.5,"RU","T",false,5)
	expect(particles.particles.size()==2 and particles.particles[1].position==Vector2(24,24),"original half-density staggered grid preserves its independent lh row divisor")
	var position: Vector2=particles.particles[0].position; particles.stop(); particles.advance_ticks(3)
	expect(particles.particles[0].position==position,"stopped particle instances retain all motion state")
	particles.all_move(3,4); particles.begin(); particles.advance_ticks(1)
	expect(particles.particles[0].position!=position and particles.particles[0].position.x>=position.x+3,"particle origins follow relocation and restart their own motion clock")
	particles.dispose()
	var mask=Image.create(480,480,false,Image.FORMAT_RGBA8); mask.fill(Color8(12,0,0)); var broken=Broken.new(); var shards=broken.configure(image,mask,11)
	expect(shards.ok and shards.count==1 and broken.shards[0].origin==Vector2(140,60) and broken.shards[0].texture.get_image().get_pixel(159,20).a==0,"source broken screen preserves initial subdivision, first-region origin and160pixel crop")
	for i in 90: broken.advance_tick()
	expect(broken.ticks==90 and broken.shards.is_empty(),"source broken screen disposes all shards on its ninetieth frame")
	var hidden=game.unravel_character(-1,[0,4,0.5,"RU","S",false]); model.advance(0)
	expect(hidden.ok and game._player._sprite.get_meta("flash_unravel_hidden",false) and not game._player._sprite.visible,"actual player sprite enters native frame-region unravel without modifying shared texture")
	model.reset(); model.test_capture=null; game.queue_free(); await process_frame
	expect(not model.busy() and model.particle_sets.is_empty() and model.map_visible,"scene reset releases every live effect and follower-independent particle instance")
	for message in failures: printerr("FAIL: ",message)
	print("FLASH SCREEN EFFECTS: ","PASSED" if failures.is_empty() else "FAILED"," / ",checks," checks"); quit(0 if failures.is_empty() else 1)
func expect(value: bool,message: String) -> void:
	checks+=1
	if not value: failures.append(message)
